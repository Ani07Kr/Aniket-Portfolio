PORT=5001
NODE_ENV=development

# MongoDB Connection (Optional: leave blank for zero-setup resilient embedded MongoDB)
MONGODB_URI=

# Security
JWT_SECRET=your_jwt_secret_key_change_in_production
ADMIN_EMAIL=your_email@example.com
ADMIN_PASSWORD=your_secure_admin_password

# AI Assistant API Key (Optional: fallback intelligent engine works out of the box)
GEMINI_API_KEY=

# Client URL
CLIENT_URL=http://localhost:5173

# Live Email Notifications (Optional: Gmail SMTP with App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFICATION_EMAIL=
